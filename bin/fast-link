#!/usr/bin/env bash
# Ask for a 15 ms Bluetooth LE connection interval instead of the kernel's 30-50 ms default.
# The remote sends one report per connection event: voice needs 50 packets a second (20 ms
# Opus frames), which only an interval under 20 ms carries; at 30 ms the remote falls behind
# while you speak (measured: 3.9 s of speech arrived over 5.1 s). Touch reports also arrive
# sooner and in smaller bursts. Apple's accessory rules allow a minimum of 15 ms with a maximum
# at least 15 ms above it, or exactly 15 ms for both; the remote refuses 7.5 ms.
#
# BlueZ's per-device [ConnectionParameters] did not reach the connect command, so this sets
# the default for all LE devices in /etc/bluetooth/main.conf. Restarts bluetooth.
# `bin/fast-link off` puts the default back.
set -euo pipefail
off=false
[[ ${1:-} == off ]] && off=true
conf=/etc/bluetooth/main.conf

# Units of 1.25 ms: 12 = 15 ms. Only the two interval lines under [LE] change;
# with `off` they go back to commented out.
sudo awk -v off="$off" '
  /^\[/ { le = ($0 == "[LE]") }
  le && /^#?MinConnectionInterval=/ { print (off == "true" ? "#MinConnectionInterval=" : "MinConnectionInterval=12"); next }
  le && /^#?MaxConnectionInterval=/ { print (off == "true" ? "#MaxConnectionInterval=" : "MaxConnectionInterval=12"); next }
  { print }
' "$conf" | sudo tee "$conf.new" >/dev/null
sudo chmod --reference="$conf" "$conf.new"
sudo mv "$conf.new" "$conf"

# An earlier version stored the interval per device; that had no effect, so remove it.
adapter=$(bluetoothctl show | sed 's/\x1b\[[0-9;]*m//g' | awk '/^Controller/ { print $2; exit }')
for info in $(sudo sh -c "ls /var/lib/bluetooth/$adapter/*/info 2>/dev/null"); do
    if sudo grep -q '^\[ConnectionParameters\]' "$info"; then
        sudo awk '/^\[/ { skip = ($0 == "[ConnectionParameters]") } !skip' "$info" | sudo tee "$info.new" >/dev/null
        sudo chmod 600 "$info.new"; sudo mv "$info.new" "$info"
    fi
done

sudo systemctl restart bluetooth
if $off; then echo "LE connection interval back to the default"; else echo "LE connection interval set to 15 ms"; fi
echo "The remote reconnects at the next button press."
